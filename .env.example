# Donk example configuration — SAFE TO COMMIT (placeholders only).
# Copy to .env and fill in real values:  Copy-Item .env.example .env
# NEVER put real keys or personal emails in this file.

# --- Model (Muse via Meta API). Leave MODEL_API_KEY empty for local demo mode.
MODEL_ID=muse-wonder-1.0
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=

# --- Repository under investigation (local path, read-only access).
REPO_PATH=./demo-data/BiddersBlock-v2

# --- History bounds (disclosed in the UI).
GIT_MAX_COMMITS=50
GIT_MAX_BLAME_LINES=200
SEARCH_MAX_RESULTS=20
SNIPPET_MAX_LINES=80

# --- Email safety. outbox = save .eml locally, nothing leaves the machine.
EMAIL_MODE=outbox
DEMO_MODE=true
DEMO_EMAIL_REDIRECT=you@example.com

# --- Real SMTP sending (only when EMAIL_MODE=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=donk@localhost
SMTP_USE_TLS=true

# --- Optional advanced settings (defaults shown).
# MODEL_TIMEOUT_S=30
# MODEL_MAX_OUTPUT_TOKENS=1200
# MODEL_MAX_TOOL_ITERS=6
# CACHE_DIR=.cache
# OUTBOX_DIR=outbox
# DB_PATH=donk.db
# TEAM_PATH=team.json
